@startuml UC25_UserManagement
autonumber

actor "Airport Administrator" as AirportAdministrator
participant "System" as Sys
database "Airport Database" as DB
participant "EmailProvider" as EmailProvider

AirportAdministrator -> Sys : Access user management
Sys -> AirportAdministrator : Display account creation form
AirportAdministrator -> Sys : Submit worker info and selected role
Sys -> DB : Validate email and role
DB --> Sys : Validation result

alt Email already exists
    Sys -> AirportAdministrator : Show error "Email already in use"
else Validation successful
    Sys -> DB : Save new user account
    DB --> Sys : Account saved
    Sys -> EmailProvider : Send access instructions
    EmailProvider --> Sys : Email sent
    Sys -> AirportAdministrator : Display success confirmation
end

@enduml
